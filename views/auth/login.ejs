<div class="flex min-h-screen items-center justify-center p-4">
  <div class="grid w-full max-w-4xl overflow-hidden rounded-2xl bg-white shadow-xl md:grid-cols-2">
    <!-- Panel branding -->
    <div class="hidden flex-col justify-between bg-brand p-8 text-white md:flex">
      <div>
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-white/15 text-2xl font-bold">P</div>
        <h1 class="text-2xl font-bold leading-snug">Perpustakaan Digital</h1>
        <p class="mt-2 text-emerald-50"><%= typeof schoolName !== 'undefined' ? schoolName : 'SMA NEGERI 1 MAJALENGKA' %></p>
      </div>
      <div class="text-sm text-emerald-50/90">
        <p class="font-medium">Membaca hari ini,</p>
        <p class="font-medium">memimpin masa depan.</p>
      </div>
    </div>

    <!-- Panel form -->
    <div class="p-8 sm:p-10">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-800">Masuk ke Akun</h2>
        <p class="mt-1 text-sm text-slate-500">Gunakan NISN atau Email yang terdaftar.</p>
      </div>

      <%- include('../partials/flash') %>

      <form method="POST" action="/login" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-700">NISN / Email</label>
          <input name="identifier" type="text" required autofocus
            placeholder="Contoh: 11111111 atau andi@..."
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-700">Password</label>
          <input name="password" type="password" required placeholder="••••••••"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20" />
        </div>
        <button type="submit"
          class="w-full rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand/40">
          Masuk
        </button>
      </form>

      <p class="mt-5 text-center text-sm text-slate-500">
        Belum punya akun?
        <a href="/register" class="font-semibold text-brand hover:text-brand-dark">Daftar sebagai Siswa</a>
      </p>

      <div class="mt-6 rounded-lg bg-slate-50 p-3 text-xs text-slate-500">
        <p class="font-semibold text-slate-600">Akun demo:</p>
        <p>Admin: <span class="font-mono">12345678</span> / <span class="font-mono">admin123</span></p>
        <p>Siswa: <span class="font-mono">11111111</span> / <span class="font-mono">siswa123</span></p>
      </div>
    </div>
  </div>
</div>
