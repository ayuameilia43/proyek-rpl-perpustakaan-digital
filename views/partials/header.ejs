<%
  const roleLabel = user.role === 'admin' ? 'Administrator' : (user.role === 'pustakawan' ? 'Pustakawan' : 'Siswa');
  const roleColor = user.role === 'admin'
    ? 'bg-emerald-100 text-emerald-700'
    : (user.role === 'pustakawan' ? 'bg-blue-100 text-blue-700' : 'bg-indigo-100 text-indigo-700');
  const initials = (user.full_name || '?').split(' ').filter(Boolean).map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase();
%>
<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center gap-3">
      <button id="sidebar-toggle" class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden" aria-label="Buka menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/></svg>
      </button>
      <div class="min-w-0">
        <h1 class="truncate text-lg font-semibold text-slate-800"><%= title %></h1>
        <p class="hidden text-xs text-slate-500 sm:block"><%= schoolName %></p>
      </div>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/profil" class="group flex items-center gap-2 rounded-xl px-1.5 py-1 transition hover:bg-slate-50 sm:gap-3 sm:px-2.5"
        title="Pengaturan Akun">
        <div class="hidden text-right sm:block">
          <p class="text-sm font-semibold leading-tight text-slate-800 group-hover:text-brand"><%= user.full_name %></p>
          <p class="text-xs text-slate-500"><%= user.class ? user.class + ' · ' : '' %><%= user.nisn %></p>
        </div>
        <span class="hidden rounded-full px-2.5 py-1 text-xs font-semibold sm:inline-block <%= roleColor %>"><%= roleLabel %></span>
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-brand/10 text-sm font-bold text-brand">
          <%= initials %>
        </div>
      </a>
      <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit"
          class="rounded-lg border border-slate-200 px-2.5 py-2 text-xs font-medium text-slate-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600"
          title="Keluar">
          <span class="hidden sm:inline">Keluar</span>
          <svg class="h-4 w-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H3"/></svg>
        </button>
      </form>
    </div>
  </div>
</header>
