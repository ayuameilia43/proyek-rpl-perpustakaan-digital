<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= typeof schoolName !== 'undefined' ? schoolName : 'Perpustakaan Digital' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { DEFAULT: '#059669', dark: '#047857', light: '#10b981' },
            card: '#1E293B'
          }
        }
      }
    };
  </script>
</head>
<body class="min-h-full bg-gradient-to-br from-emerald-50 via-white to-slate-100 font-sans text-slate-800 antialiased">
  <%- body %>
  <script src="/js/app.js"></script>
</body>
</html>
