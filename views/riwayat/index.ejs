<div class="mb-6">
  <h2 class="text-xl font-bold text-slate-800">Riwayat Peminjaman</h2>
  <p class="text-sm text-slate-500">Daftar lengkap riwayat pengajuan pinjam beserta status, tanggal, dan denda.</p>
</div>

<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
  <table class="w-full text-left text-sm">
    <thead class="text-xs uppercase text-slate-400">
      <tr>
        <th class="px-3 py-2">Tanggal Pinjam</th>
        <th class="px-3 py-2">Jatuh Tempo</th>
        <th class="px-3 py-2">Kembali</th>
        <th class="px-3 py-2">Status</th>
        <th class="px-3 py-2">Buku</th>
        <th class="px-3 py-2">Format</th>
        <th class="px-3 py-2">Denda</th>
        <th class="px-3 py-2">Status Bayar</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if (!transactions.length) { %>
        <tr><td colspan="8" class="px-3 py-8 text-center text-sm text-slate-500">Belum ada riwayat peminjaman.</td></tr>
      <% } %>
      <% transactions.forEach(function (t) { %>
        <tr>
          <td class="px-3 py-2 text-slate-500"><%= t.borrow_date %></td>
          <td class="px-3 py-2 text-slate-500"><%= t.due_date %></td>
          <td class="px-3 py-2 text-slate-500"><%= t.return_date || '-' %></td>
          <td class="px-3 py-2">
            <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= t.status === 'terlambat' ? 'bg-red-100 text-red-700' : (t.status === 'dipinjam' ? 'bg-blue-100 text-blue-700' : (t.status === 'dikembalikan' ? 'bg-emerald-100 text-emerald-700' : (t.status === 'menunggu_persetujuan' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600'))) %>"><%= t.status %></span>
          </td>
          <td class="px-3 py-2 font-medium text-slate-700"><%= t.title %></td>
          <td class="px-3 py-2">
            <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= t.format === 'e-book' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= t.format === 'e-book' ? 'E-Book' : 'Fisik' %></span>
          </td>
          <td class="px-3 py-2 text-slate-600">Rp <%= Number(t.fine_amount || 0).toLocaleString('id-ID') %></td>
          <td class="px-3 py-2">
            <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= t.fine_paid_status === 'lunas' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>"><%= t.fine_paid_status === 'lunas' ? 'Lunas' : 'Belum Lunas' %></span>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
