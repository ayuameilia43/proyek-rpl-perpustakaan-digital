<div class="mb-6">
  <h2 class="text-xl font-bold text-slate-800">Proses Peminjaman</h2>
  <p class="text-sm text-slate-500">Setujui/tolak pengajuan peminjaman, proses pengembalian, dan verifikasi denda.</p>
</div>

<div class="mb-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h3 class="mb-4 text-base font-semibold text-slate-800">Permintaan Menunggu Persetujuan</h3>
  <% if (!pending.length) { %>
    <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">Tidak ada permintaan yang menunggu.</p>
  <% } %>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="text-xs uppercase text-slate-400">
        <tr>
          <th class="px-3 py-2">NISN</th>
          <th class="px-3 py-2">Siswa</th>
          <th class="px-3 py-2">Buku</th>
          <th class="px-3 py-2">Format</th>
          <th class="px-3 py-2">Jatuh Tempo</th>
          <th class="px-3 py-2 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% pending.forEach(function (t) { %>
          <tr>
            <td class="px-3 py-2 font-mono text-xs"><%= t.nisn %></td>
            <td class="px-3 py-2 font-medium text-slate-700"><%= t.full_name %></td>
            <td class="px-3 py-2 text-slate-600"><%= t.title %></td>
            <td class="px-3 py-2">
              <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= t.format === 'e-book' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                <%= t.format === 'e-book' ? 'E-Book' : 'Fisik' %>
              </span>
            </td>
            <td class="px-3 py-2 text-slate-500"><%= t.due_date %></td>
            <td class="px-3 py-2">
              <div class="flex items-center justify-end gap-2">
                <form method="POST" action="/admin/peminjaman/approve">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                  <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-500">Setujui</button>
                </form>
                <form method="POST" action="/admin/peminjaman/reject">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                  <input name="reason" type="text" placeholder="Alasan (opsional)"
                    class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs outline-none" />
                  <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50">Tolak</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h3 class="mb-4 text-base font-semibold text-slate-800">Peminjaman Aktif / Terlambat</h3>
  <% if (!active.length) { %>
    <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">Tidak ada peminjaman aktif.</p>
  <% } %>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="text-xs uppercase text-slate-400">
        <tr>
          <th class="px-3 py-2">NISN</th>
          <th class="px-3 py-2">Siswa</th>
          <th class="px-3 py-2">Buku</th>
          <th class="px-3 py-2">Status</th>
          <th class="px-3 py-2">Jatuh Tempo</th>
          <th class="px-3 py-2">Denda</th>
          <th class="px-3 py-2 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% active.forEach(function (t) { %>
          <tr>
            <td class="px-3 py-2 font-mono text-xs"><%= t.nisn %></td>
            <td class="px-3 py-2 font-medium text-slate-700"><%= t.full_name %></td>
            <td class="px-3 py-2 text-slate-600"><%= t.title %></td>
            <td class="px-3 py-2">
              <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= t.status === 'terlambat' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700' %>"><%= t.status %></span>
            </td>
            <td class="px-3 py-2 text-slate-500"><%= t.due_date %></td>
            <td class="px-3 py-2 text-slate-600">Rp <%= Number(t.fine_amount || 0).toLocaleString('id-ID') %></td>
            <td class="px-3 py-2 text-right">
              <div class="flex items-center justify-end gap-2">
                <form method="POST" action="/admin/peminjaman/remind">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                  <button type="submit" class="rounded-lg border border-emerald-300 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50">Kirim Pengingat WA</button>
                </form>
                <form method="POST" action="/admin/peminjaman/return">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                  <button type="submit" class="rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-500">Proses Pengembalian</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
