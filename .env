# Environment Configuration - Perpustakaan Digital SMA NEGERI 1 MAJALENGKA

# Database
# MySQL (Laragon). Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Jika password kosong, biarkan kosong setelah titik dua (contoh: root:@localhost)
DATABASE_URL="mysql://root:@localhost:3306/perpustakaan_sma"

# Application
APP_NAME="Perpustakaran Digital SMA NEGERI 1 MAJALENGKA"
APP_PORT=3000
APP_URL=http://localhost:3000

# Authentication
BCRYPT_SALT_ROUNDS=10
JWT_SECRET="perpus-sma-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="perpus-sma-session-secret-change-in-production"

# WhatsApp Gateway (System Settings - konfigurasi dinamis)
WHATSAPP_API_ENDPOINT=""
WHATSAPP_API_TOKEN=""
WHATSAPP_TEMPLATE_PINJAM=""
WHATSAPP_TEMPLATE_KEMBALI=""
WHATSAPP_TEMPLATE_TERLAMBAT=""

# AI Service Configuration (System Settings - Konfigurasi AI)
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_TEMPERATURE=0.7
AI_SYSTEM_PROMPT="Anda adalah asisten pustakawan SMA yang membantu siswa mencari buku dan informasi perpustakaan. Jawabannya harus selalu relevan dengan literasi, katalog buku, aturan peminjaman, dan denda perpustakaan SMA NEGERI 1 MAJALENGKA. Jangan memberikan jawaban di luar konteks perpustakaan."
AI_API_KEY=""
IS_CHATBOT_ACTIVE=true

# Application Settings (dari System Settings)
MAX_BOOKS_PER_STUDENT=3
MAX_BORROW_DURATION=7
FINE_PER_DAY=1000
OPERATING_HOURS_START="07:00"
OPERATING_HOURS_END="21:00"

# School Information
SCHOOL_NAME="SMA NEGERI 1 MAJALENGKA"
SCHOOL_ADDRESS=""