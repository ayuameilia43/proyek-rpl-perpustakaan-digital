{
  "name": "perpustakaan-digital",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node prisma/migrate.js",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node prisma/migrate.js && node prisma/seed.js",
    "test": "node --test --require ./test/setup.js \"test/**/*.test.js\"",
    "test:watch": "node --test --watch --require ./test/setup.js \"test/**/*.test.js\"",
    "test:coverage": "node --test --require ./test/setup.js --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/index.js --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=70 \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "prisma": "8.0.0-rc.33"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
