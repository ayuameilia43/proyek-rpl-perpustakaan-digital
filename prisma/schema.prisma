// Prisma schema - Perpustakaan Digital SMA NEGERI 1 MAJALENGKA
// Database: MySQL (Laragon) - provider mysql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  siswa
  pustakawan
  admin
}

enum BookFormat {
  fisik
  e_book
  keduanya
}

enum TransactionStatus {
  menunggu_persetujuan
  dipinjam
  ditolak
  dikembalikan
  terlambat
}

enum FinePaidStatus {
  lunas
  belum_lunas
}

enum AiProvider {
  gemini
  grok
  nvidia
}

model User {
  id               String   @id @default(uuid()) @db.Char(36)
  nisn             String   @unique @db.VarChar(20)
  full_name        String   @db.VarChar(100)
  class            String?  @db.VarChar(50)
  whatsapp_number  String?  @db.VarChar(20)
  email            String   @unique @db.VarChar(100)
  password_hash    String   @db.VarChar(255)
  role             Role     @default(siswa)
  is_active        Boolean  @default(true)
  max_books_allowed Int     @default(3)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  transactions     Transaction[]
  chatHistories    AIChatHistory[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(50)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  books       Book[]

  @@map("categories")
}

model Book {
  id               String     @id @default(uuid()) @db.Char(36)
  title            String     @db.VarChar(200)
  author           String     @db.VarChar(100)
  publisher        String?    @db.VarChar(100)
  year             Int?
  ISBN             String     @unique @db.VarChar(20)
  category_id      String     @db.Char(36)
  format           BookFormat
  total_stock_fisic Int       @default(0)
  stock_fisic      Int        @default(0)
  synopsis         String?    @db.Text
  stock_ebook      Int        @default(0)
  cover_image_url  String?    @db.Text
  pdf_e_book_url   String?    @db.Text
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  category         Category   @relation(fields: [category_id], references: [id])
  transactions     Transaction[]

  @@map("books")
}

model Transaction {
  id               String            @id @default(uuid()) @db.Char(36)
  user_id          String            @db.Char(36)
  book_id          String            @db.Char(36)
  status           TransactionStatus @default(menunggu_persetujuan)
  borrow_date      DateTime          @db.Date
  due_date         DateTime          @db.Date
  return_date      DateTime?         @db.Date
  fine_amount      Decimal           @default(0) @db.Decimal(10, 2)
  fine_paid_status FinePaidStatus    @default(belum_lunas)
  admin_notes      String?           @db.Text
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  user             User              @relation(fields: [user_id], references: [id])
  book             Book              @relation(fields: [book_id], references: [id])

  @@map("transactions")
}

model SystemSettings {
  id                    String     @id @default(uuid()) @db.Char(36)
  school_name           String     @default("SMA NEGERI 1 MAJALENGKA") @db.VarChar(200)
  school_address        String?    @db.Text
  ai_api_key            String?    @db.VarChar(255)
  fine_per_day          Decimal    @default(1000) @db.Decimal(10, 2)
  max_borrow_duration   Int        @default(7)
  max_books_per_student Int        @default(3)
  operating_hours_start String     @default("07:00:00") @db.Time(0)
  operating_hours_end   String     @default("21:00:00") @db.Time(0)
  whatsapp_api_endpoint String?    @db.Text
  whatsapp_api_token    String?    @db.Text
  whatsapp_template_pinjam    String? @db.Text
  whatsapp_template_kembali   String? @db.Text
  whatsapp_template_terlambat String? @db.Text
  ai_provider           AiProvider @default(gemini)
  ai_model              String     @default("gemini-2.5-flash") @db.VarChar(50)
  ai_temperature        Float      @default(0.7)
  ai_system_prompt      String?    @db.Text
  is_chatbot_active     Boolean    @default(true)
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt

  @@map("system_settings")
}

model AIChatHistory {
  id           String   @id @default(uuid()) @db.Char(36)
  user_id      String   @db.Char(36)
  session_id   String   @db.VarChar(100)
  user_message String   @db.Text
  ai_response  String?  @db.Text
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id])

  @@map("ai_chat_history")
}
